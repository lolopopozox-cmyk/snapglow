# SnapGlow - Environment Variables
# Copy this to .env.local for local dev, or set in Vercel dashboard

# Nomask AI API Key (for text generation / uncensored model)
# NEVER put real keys in this file - it gets pushed to GitHub!
# Put the real key in Vercel: Settings > Environment Variables
NOMASK_API_KEY=your_nomask_api_key_here

# Image Generation API (configurable; set your own endpoint)
IMAGE_API_URL=https://nomask.ai/api/v1
IMAGE_API_KEY=your_nomask_api_key_here
IMAGE_MODEL=deepseek/deepseek-v4-pro

# Admin password for /admin-sec-portal-x92a (set a STRONG unique password)
ADMIN_PASSWORD=choose_a_strong_password_here

# Contact fallback email
CONTACT_EMAIL=mranonymous.efx@gmail.com